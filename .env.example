# ---------------------------------------------------------------------------
# Quadbiz Solar — environment variables
# Copy this file to .env.local and fill in real values.
# ---------------------------------------------------------------------------

# Canonical site origin. Every canonical URL, sitemap entry, OG URL and schema
# @id derives from this — the domain is never hardcoded anywhere else.
# NOTE: quadbizsolar.com is a placeholder; update once the domain is booked.
NEXT_PUBLIC_SITE_URL=https://quadbizsolar.com

# Google Apps Script Web App URL that receives lead-form submissions.
# Leave empty until the Apps Script is deployed — the form degrades gracefully.
LEAD_FORM_ENDPOINT=

# --- Future integrations (not used yet) -------------------------------------
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
